# The engine's full supported configuration is in engine/.env.example.
# Defaults deliberately disable paid queries and automated sends.
DATAFORSEO_PAID_ENABLED=NO
DATAFORSEO_AUTO_GAP=NO
PR_SEND_ENABLED=NO
BRAVE_API_KEY=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GOOGLE_CRM_SPREADSHEET_ID=
MAX_SEND_PER_DAY=6
MAX_SEND_PER_WEEK=30
MAX_SEARCHES_PER_DAY=12
