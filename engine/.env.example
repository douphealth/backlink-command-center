# v4 private, independent worker settings. This file is a template; secrets belong ONLY in .env.
# Do not publish .env, historical contact records, refresh tokens or SQLite data.

# Research: no autonomous live search API calls without an authorized key.
BRAVE_API_KEY=
MAX_SEARCHES_PER_DAY=12
MAX_SEARCHES_PER_RUN=3
MAX_ASSET_CHECKS_PER_RUN=5

# Existing portfolio CRM is READ-ONLY to this worker. Google OAuth scope needed:
# https://www.googleapis.com/auth/spreadsheets.readonly
GOOGLE_CRM_SPREADSHEET_ID=
PR_CRM_SYNC_HOURS=12

# Independent Google OAuth for the VPS worker; ChatGPT's Gmail connector tokens are NOT shared.
# scopes: gmail.readonly + gmail.compose; Google Sheets read-only for CRM import.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Outbound mail is explicitly OFF until independently authenticated, history seeded,
# publisher-specific editorial permissions verified and other sender tasks disabled.
PR_SEND_ENABLED=NO
PR_REQUIRE_HISTORY_SEED=YES
MAX_SEND_PER_DAY=6
MAX_SEND_PER_WEEK=30
# Inside Docker, copy initial-suppression.csv privately into /app/state (mounted volume).
PR_INITIAL_SUPPRESSION_CSV=/app/state/initial-suppression.csv

# One worker process. Research every 4h; Gmail reply watch independently every hour.
PR_RUN_INTERVAL_SECONDS=14400
PR_MONITOR_INTERVAL_SECONDS=3600
MAX_THREAD_CHECKS_PER_HOUR=30
PR_DB_PATH=/app/state/outreach.sqlite3
PR_CONFIG=config/sites.json

# DataForSEO: all paid calls OFF unless BOTH opt-ins are YES and credentials exist.
# NO paid API is used during the default background research run.
# Prefer the optional Compose secret mount (no login/password embedded in .env).
# Use -f compose.yaml -f compose.dataforseo.yaml for the secret override.
# DATAFORSEO_AUTH_HOST_FILE=/srv/portfolio-pr/secrets/dataforseo-auth.txt
# The secret file contains Base64(login:password), just like the uploaded file.
# DATAFORSEO_BASIC_AUTH_FILE=/run/secrets/dataforseo_auth
# Legacy alternative: explicit login/password variables (less preferred).
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
DATAFORSEO_PAID_ENABLED=NO
DATAFORSEO_AUTO_GAP=NO
# Actual costs are read from free DataForSEO user_data account/pricing API.
# The code refuses budgets exceeding these audited maximums (USD).
DFS_MAX_USD_PER_DAY=0.12
DFS_MAX_USD_PER_MONTH=1.00
DFS_MAX_USD_PER_REQUEST=0.06
DFS_MAX_PAID_CALLS_DAY=3
DFS_MAX_CALLS_SITE_DAY=2
DFS_MAX_ROWS=75
DFS_CACHE_DAYS=21
DFS_MONITOR_EXTERNAL_SPEND=YES
