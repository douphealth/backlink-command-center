# PRIVATE: Never commit your real values
DASHBOARD_ADMIN_PASSWORD=replace-with-long-unique-admin-password
DASHBOARD_SESSION_SECRET=replace-with-random-secret-at-least-32-characters-long
DASHBOARD_COOKIE_SECURE=true
